{
  "name": "mes-comptes",
  "version": "1.0.0",
  "description": "Application de gestion comptable personnelle",
  "main": "main.js",
  "scripts": {
    "start":       "electron .",
    "build:win":   "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:all":   "electron-builder --win --linux --x64"
  },
  "devDependencies": {
    "electron":         "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId":       "com.loube.mescomptes",
    "productName": "Mes Comptes",
    "copyright":   "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist_backend",
        "to":   "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend_dist",
        "to":   "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../_data",
        "to":   "backend/_data",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon":   "assets/icon.ico"
    },
    "linux": {
      "target":   [{ "target": "AppImage", "arch": ["x64"] }],
      "icon":     "assets/icon.png",
      "category": "Finance"
    },
    "nsis": {
      "oneClick":                        false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut":           true,
      "runAfterFinish":                  true,
      "installerIcon":                   "assets/icon.ico",
      "uninstallerIcon":                 "assets/icon.ico"
    }
  }
}