{
  "name": "mes-comptes",
  "version": "1.0.0",
  "description": "Application de gestion comptable personnelle",
  "author": "Loube",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.loube.mescomptes",
    "productName": "Mes Comptes",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/backend_app.exe",
        "to": "backend/backend_app.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../_data",
        "to": "_data",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend_dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../_data",
        "to": "backend/_data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
